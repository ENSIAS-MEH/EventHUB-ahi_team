{
  "id": null,
  "uid": "billetterie-overview",
  "title": "Services Overview",
  "description": "Vue d'ensemble des microservices Billetterie Dark — métriques, logs, traces",
  "tags": ["billetterie", "monitoring"],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "multi": true,
        "includeAll": true,
        "allValue": "auth-service|event-service|booking-service",
        "query": "auth-service,event-service,booking-service",
        "current": {
          "value": ["$__all"],
          "text": ["All"]
        },
        "options": [
          { "selected": true,  "text": "All",             "value": "$__all" },
          { "selected": false, "text": "auth-service",    "value": "auth-service" },
          { "selected": false, "text": "event-service",   "value": "event-service" },
          { "selected": false, "text": "booking-service", "value": "booking-service" }
        ]
      },
      {
        "name": "interval",
        "label": "Interval",
        "type": "interval",
        "auto": true,
        "auto_count": 30,
        "auto_min": "10s",
        "query": "auto,30s,1m,5m,10m",
        "current": { "value": "auto", "text": "auto" },
        "options": [
          { "selected": true,  "text": "auto", "value": "auto" },
          { "selected": false, "text": "30s",  "value": "30s" },
          { "selected": false, "text": "1m",   "value": "1m" },
          { "selected": false, "text": "5m",   "value": "5m" },
          { "selected": false, "text": "10m",  "value": "10m" }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Requêtes totales (5m)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          },
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum(increase(http_server_requests_seconds_count{application=~\"auth-service|event-service|booking-service\"}[5m]))",
          "legendFormat": "Total",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Taux d'erreurs 5xx",
      "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=~\"auth-service|event-service|booking-service\",status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count{application=~\"auth-service|event-service|booking-service\"}[5m]))",
          "legendFormat": "Erreurs 5xx",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Latence P95 moyenne",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "avg(histogram_quantile(0.95, rate(http_server_requests_seconds_bucket{application=~\"auth-service|event-service|booking-service\"}[5m])))",
          "legendFormat": "P95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Services UP",
      "type": "stat",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "green", "value": 3 }
            ]
          },
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum(up{job=~\"auth-service|event-service|booking-service\"})",
          "legendFormat": "Services UP",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "CPU Usage par service",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": { "lineWidth": 2 }
        }
      },
      "targets": [
        {
          "expr": "process_cpu_usage{application=~\"$service\"}",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "RAM Heap utilisée par service",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 4, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "lineWidth": 2 }
        }
      },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{application=~\"$service\", area=\"heap\"}",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Latence HTTP P95 par service",
      "type": "timeseries",
      "gridPos": { "x": 16, "y": 4, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "lineWidth": 2 }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(http_server_requests_seconds_bucket{application=~\"$service\"}[5m]))",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Requêtes par seconde par service",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 2 }
        }
      },
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count{application=~\"$service\"}[1m])",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Répartition codes HTTP par service",
      "type": "barchart",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "orientation": "auto",
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 1 }
        }
      },
      "targets": [
        {
          "expr": "sum by (application, status) (rate(http_server_requests_seconds_count{application=~\"$service\",status=~\"2..\"}[5m]))",
          "legendFormat": "{{application}} 2xx",
          "refId": "A"
        },
        {
          "expr": "sum by (application, status) (rate(http_server_requests_seconds_count{application=~\"$service\",status=~\"4..\"}[5m]))",
          "legendFormat": "{{application}} 4xx",
          "refId": "B"
        },
        {
          "expr": "sum by (application, status) (rate(http_server_requests_seconds_count{application=~\"$service\",status=~\"5..\"}[5m]))",
          "legendFormat": "{{application}} 5xx",
          "refId": "C"
        }
      ]
    },
    {
      "id": 10,
      "title": "Derniers logs ERROR / WARN",
      "type": "logs",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "expr": "{container=~\"auth-service|event-service|booking-service\"} | json | level=~\"ERROR|WARN\"",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Fréquence des erreurs par service",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 2 }
        }
      },
      "targets": [
        {
          "expr": "sum by (container) (rate({container=~\"auth-service|event-service|booking-service\"} | json | level=\"ERROR\" [5m]))",
          "legendFormat": "{{container}}",
          "refId": "A"
        }
      ]
    }
  ]
}
